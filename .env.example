# Local development. Copy to .env and fill in.
# .env is gitignored — never commit real values.

# ── Database (local Postgres) ────────────────────────────────────────
# Leave DB_USERNAME/DB_PASSWORD blank to connect as your own macOS user,
# which is how Homebrew's postgresql@14 is set up by default.
DB_HOST=localhost
# DB_USERNAME=
# DB_PASSWORD=

# ─────────────────────────────────────────────────────────────────────
# Everything below is PRODUCTION-only and is set with `fly secrets set`,
# never in this file. Listed here so the full set is documented in one
# place. See DEPLOYING.md for the walkthrough.
# ─────────────────────────────────────────────────────────────────────

# Decrypts config/credentials.yml.enc. Value is in config/master.key.
#   fly secrets set RAILS_MASTER_KEY="$(cat config/master.key)"
# RAILS_MASTER_KEY=

# Set automatically by Fly when you attach a Postgres cluster.
# DATABASE_URL=

# Your public hostname, no scheme (e.g. recipy.app). Drives Host
# authorization and the links inside password-reset emails.
# APP_HOST=

# Object storage for recipe photos — Tigris, Cloudflare R2 or S3.
# Uploads land on ephemeral disk without these and vanish on each deploy.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_BUCKET=
# AWS_ENDPOINT_URL_S3=
# AWS_REGION=auto

# SMTP for password-reset email. Defaults to Resend's host; any provider works.
# SMTP_ADDRESS=smtp.resend.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=

# Set to "true" to enforce the Content Security Policy rather than only
# reporting violations. Do this after checking the browser console.
# CSP_ENFORCE=false
