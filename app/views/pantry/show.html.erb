<div class="pantry-container">
  <!-- Header -->
  <div class="pantry-header">
    <div class="pantry-header-content">
      <div>
        <h1 class="pantry-title icon-label"><%= icon(:home, size: 22) %>My Pantry</h1>
        <p class="pantry-subtitle">
          Ingredients you always keep stocked. These will be auto-marked as
          <strong>"on hand"</strong> when added to grocery lists.
        </p>
      </div>
      <div class="pantry-header-actions">
        <%= link_to seed_defaults_pantry_path,
              data: { turbo_method: :post, turbo_confirm: "This will reset your pantry to default staples. Continue?" },
              class: "btn btn-secondary" do %>
          <%= icon(:refresh, size: 16) %>Reset to Defaults
        <% end %>
      </div>
    </div>
  </div>

  <!-- Add Item Form -->
  <div class="form-card mt-3">
    <div class="card-header">
      <div class="card-title">
        <span class="icon-plate icon-plate--sm"><%= icon(:plus, size: 17) %></span>
        <h3>Add to Pantry</h3>
      </div>
    </div>
    <div class="card-body">
      <%= form_with url: add_item_pantry_path, method: :post, local: true do |f| %>
        <div class="pantry-add-row">
          <div class="form-group pantry-add-input">
            <%= f.label :ingredient_name, "Ingredient", class: "visually-hidden" %>
            <%= f.text_field :ingredient_name,
                placeholder: "e.g., cumin, rice, soy sauce...",
                class: "form-input",
                required: true %>
          </div>
          <div class="form-group">
            <%= f.submit "Add", class: "btn" %>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Pantry Items by Category -->
  <div class="pantry-stats mt-3">
    <span class="pantry-count"><%= current_user.pantry_items.count %> items in your pantry</span>
  </div>

  <% if @items_by_category.any? %>
    <div class="pantry-categories mt-2">
      <% @items_by_category.each do |category, items| %>
        <div class="pantry-category card mt-2">
          <div class="pantry-category-header">
            <span class="pantry-category-icon icon-plate icon-plate--sm icon-plate--neutral"><%= category_icon(category, size: 17) %></span>
            <h3><%= category&.capitalize || 'Other' %></h3>
            <span class="pantry-category-count"><%= items.size %></span>
          </div>

          <div class="pantry-category-items">
            <% items.each do |pantry_item| %>
              <div class="pantry-item">
                <span class="pantry-item-name"><%= pantry_item.ingredient.name %></span>
                <%= link_to remove_item_pantry_path(ingredient_id: pantry_item.ingredient_id),
                      data: { turbo_method: :delete, turbo_confirm: "Remove #{pantry_item.ingredient.name} from pantry?" },
                      class: "pantry-item-remove",
                      title: "Remove from pantry" do %>
                  <%= icon(:close, size: 14, title: "Remove #{pantry_item.ingredient.name} from pantry") %>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="mt-3">
      <%= render "shared/empty_state",
            icon_name: :home,
            title: "Your pantry is empty",
            text: "Add the ingredients you always keep in — Recipy will quietly mark them as on hand on every grocery list.",
            action_label: "Add default staples",
            action_path: seed_defaults_pantry_path,
            action_icon: :refresh,
            action_data: { turbo_method: :post } %>
    </div>
  <% end %>

  <!-- Back Link -->
  <div class="back-link mt-3">
    <%= link_to grocery_lists_path, class: "link-secondary icon-label" do %>
      <%= icon(:arrow_left, size: 15) %>Back to Grocery Lists
    <% end %>
  </div>
</div>
