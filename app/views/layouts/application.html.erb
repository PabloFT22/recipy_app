<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Recipy - Your Recipe Manager</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#faf9f7">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&display=swap">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <nav class="navbar" data-controller="navbar" aria-label="Main">
      <div class="container">
        <%= link_to "Recipy", root_path, class: "navbar-brand" %>

        <button class="navbar-hamburger"
                type="button"
                aria-label="Toggle navigation"
                aria-expanded="false"
                aria-controls="navbar-menu"
                data-navbar-target="hamburger"
                data-action="click->navbar#toggle">
          <span class="navbar-hamburger-line"></span>
          <span class="navbar-hamburger-line"></span>
          <span class="navbar-hamburger-line"></span>
        </button>

        <% if user_signed_in? %>
          <div class="navbar-menu" id="navbar-menu" data-navbar-target="menu">
            <%= nav_link_to "Recipes", recipes_path, match: :recipes %>
            <%= nav_link_to "Meal Plans", meal_plans_path, match: [:meal_plans, :meal_plan_recipes] %>
            <%= nav_link_to "Grocery Lists", grocery_lists_path, match: [:grocery_lists, :grocery_list_items] %>
            <%= nav_link_to "Collections", recipe_collections_path, match: :recipe_collections %>
            <%= nav_link_to "Pantry", pantry_path, match: :pantry %>
            <%= link_to "Sign Out", destroy_user_session_path,
                        class: "nav-link nav-link--quiet",
                        data: { turbo_method: :delete, action: "click->navbar#closeFromLink" } %>
          </div>
        <% else %>
          <div class="navbar-menu" id="navbar-menu" data-navbar-target="menu">
            <%= nav_link_to "Sign In", new_user_session_path %>
            <%= link_to "Sign Up", new_user_registration_path,
                        class: "btn btn-sm",
                        data: { action: "click->navbar#closeFromLink" } %>
          </div>
        <% end %>
      </div>
    </nav>

    <div class="toast-stack" role="status" aria-live="polite">
      <% if notice %>
        <div class="alert alert-notice" data-controller="flash" data-flash-delay-value="4000">
          <span class="alert-icon"><%= icon(:check_circle, size: 18) %></span>
          <span class="alert-message"><%= notice %></span>
          <button class="alert-dismiss" data-action="click->flash#dismiss" aria-label="Dismiss notification">&times;</button>
        </div>
      <% end %>

      <% if alert %>
        <div class="alert alert-alert" data-controller="flash" data-flash-delay-value="6000">
          <span class="alert-icon"><%= icon(:warning, size: 18) %></span>
          <span class="alert-message"><%= alert %></span>
          <button class="alert-dismiss" data-action="click->flash#dismiss" aria-label="Dismiss notification">&times;</button>
        </div>
      <% end %>
    </div>

    <main class="container" id="main-content">
      <%= yield %>
    </main>

    <footer>
      <div class="container">
        <p class="footer-inner">
          <span class="footer-mark">Recipy</span>
          <span aria-hidden="true">·</span>
          <span>Your personal recipe manager</span>
          <span aria-hidden="true">·</span>
          <span>&copy; <%= Date.current.year %></span>
        </p>
      </div>
    </footer>
  </body>
</html>
