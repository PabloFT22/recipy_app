<div class="flex justify-between items-center mb-4">
  <h1>My Pantry</h1>
  <div class="flex gap-2">
    <%= link_to suggest_pantry_items_path, class: "btn btn-secondary" do %>
      <%= icon(:plate, size: 16) %>Recipe Suggestions
    <% end %>
  </div>
</div>

<% if @expiring_soon.any? %>
  <div class="alert alert-alert mb-4">
    <strong class="icon-label"><%= icon(:warning, size: 15) %>Expiring soon:</strong>
    <% @expiring_soon.each do |item| %>
      <span><%= item.ingredient.name %> (<%= item.expiration_date.strftime('%b %d') %>)</span>
    <% end %>
  </div>
<% end %>

<div class="grid grid-2 mb-4">
  <div class="card">
    <h2>Add Item</h2>
    <%= render "form" %>
  </div>
</div>

<% if @items_by_category.any? %>
  <% @items_by_category.each do |category, items| %>
    <div class="card mb-3">
      <h3 class="mb-3"><%= category.capitalize %></h3>
      <table class="data-table">
        <thead>
          <tr>
            <th>Ingredient</th>
            <th>Quantity</th>
            <th>Unit</th>
            <th>Expires</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% items.each do |item| %>
            <tr class="<%= 'row--warn' if item.expiring? %>">
              <td><%= item.ingredient.name %></td>
              <td><%= item.quantity %></td>
              <td><%= item.unit %></td>
              <td>
                <% if item.expiration_date %>
                  <span class="<%= item.expired? ? 'text-danger' : '' %>">
                    <%= item.expiration_date.strftime('%b %d, %Y') %>
                    <%= '(expired)' if item.expired? %>
                  </span>
                <% end %>
              </td>
              <td>
                <%= link_to "Remove", pantry_item_path(item),
                    data: { turbo_method: :delete, turbo_confirm: "Remove from pantry?" },
                    class: "btn btn-danger btn-sm" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
<% else %>
  <div class="card text-center">
    <p>Your pantry is empty. Add some ingredients to get started!</p>
  </div>
<% end %>
