<div class="auth-shell">
  <div class="auth-card">
    <div class="auth-head">
      <span class="icon-plate icon-plate--lg icon-plate--info"><%= icon(:lock, size: 24) %></span>
      <h1 class="auth-title">Choose a new password</h1>
      <p class="auth-subtitle">Then you're straight back to cooking.</p>
    </div>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "auth-form" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>
      <%= f.hidden_field :reset_password_token %>

      <div class="form-group">
        <%= f.label :password, "New password", class: "form-label" %>
        <%= f.password_field :password, autofocus: true, autocomplete: "new-password", class: "form-input" %>
        <% if @minimum_password_length %>
          <p class="form-hint"><%= @minimum_password_length %> characters minimum.</p>
        <% end %>
      </div>

      <div class="form-group">
        <%= f.label :password_confirmation, "Confirm new password", class: "form-label" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-input" %>
      </div>

      <%= f.submit "Change my password", class: "btn btn-block btn-large" %>
    <% end %>

    <%= render "devise/shared/links" %>
  </div>
</div>
