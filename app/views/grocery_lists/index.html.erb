<div class="gl-container">
  <%= render "shared/page_header",
        title: "Grocery Lists",
        eyebrow: "Shopping",
        lead: "Lists you've built by hand or generated from a meal plan.",
        actions: capture {
          concat(link_to(pantry_path, class: "btn btn-secondary") { safe_join([icon(:home, size: 16), "My Pantry"]) })
          concat(link_to(new_grocery_list_path, class: "btn") { safe_join([icon(:plus, size: 16), "New Grocery List"]) })
        } %>

  <%# Status filter as a proper segmented control. %>
  <div class="segmented" role="group" aria-label="Filter lists by status">
    <% [["All", nil], ["Active", "active"], ["Completed", "completed"], ["Archived", "archived"]].each do |label, status| %>
      <% active = status.nil? ? params[:status].blank? : params[:status] == status %>
      <%= link_to label,
            status ? grocery_lists_path(status: status) : grocery_lists_path,
            class: "segmented-item gl-tab #{'segmented-item--active gl-tab--active' if active}",
            "aria-current": (active ? "true" : nil) %>
    <% end %>
  </div>

  <% if @grocery_lists.any? %>
    <div class="grid grid-3">
      <% @grocery_lists.each do |list| %>
        <article class="gl-card">
          <div class="gl-card-header">
            <h3 class="gl-card-title"><%= link_to list.name, list %></h3>
            <span class="gl-status-badge gl-status-<%= list.status %>"><%= list.status.capitalize %></span>
          </div>

          <div class="gl-card-body">
            <% if list.total_items > 0 %>
              <div class="gl-progress-mini">
                <div class="gl-progress-bar-mini"
                     role="progressbar"
                     aria-valuenow="<%= list.progress_percentage %>"
                     aria-valuemin="0"
                     aria-valuemax="100"
                     aria-label="<%= list.name %> progress">
                  <div class="gl-progress-fill-mini" style="width: <%= list.progress_percentage %>%"></div>
                </div>
                <span class="gl-progress-text-mini"><%= list.progress_percentage %>%</span>
              </div>
              <p class="gl-card-count"><%= list.checked_items %>/<%= list.total_items %> items checked</p>

              <%# A peek at what's still to buy. %>
              <% remaining = list.grocery_list_items.reject { |i| i.checked || i.on_hand }.first(3) %>
              <% if remaining.any? %>
                <ul class="gl-card-preview">
                  <% remaining.each do |item| %>
                    <li class="gl-card-preview-item">
                      <%= icon(:check, size: 12) %><%= item.display_name %>
                    </li>
                  <% end %>
                  <% outstanding = list.total_items - list.checked_items %>
                  <% if outstanding > 3 %>
                    <li class="gl-card-preview-more">+<%= outstanding - 3 %> more</li>
                  <% end %>
                </ul>
              <% end %>
            <% else %>
              <p class="gl-card-count">No items yet</p>
            <% end %>
          </div>

          <div class="gl-card-actions">
            <%= link_to "View", list, class: "btn btn-small" %>
            <% if list.status == 'active' %>
              <%= link_to "Edit", edit_grocery_list_path(list), class: "btn btn-small btn-secondary" %>
            <% end %>
            <%= link_to grocery_list_path(list),
                  data: { turbo_method: :delete, turbo_confirm: "Delete “#{list.name}”?" },
                  class: "btn btn-small btn-plain btn-plain--danger",
                  "aria-label": "Delete #{list.name}" do %>
              <%= icon(:trash, size: 15) %>
            <% end %>
          </div>
        </article>
      <% end %>
    </div>

    <div class="mt-4 text-center pagination-wrap">
      <%= paginate @grocery_lists %>
    </div>
  <% else %>
    <% if params[:status].present? %>
      <%= render "shared/empty_state",
            icon_name: :cart,
            title: "No grocery lists found",
            text: "You have no #{params[:status]} lists right now.",
            action_label: "View all lists",
            action_path: grocery_lists_path,
            action_icon: :refresh %>
    <% else %>
      <%= render "shared/empty_state",
            icon_name: :cart,
            title: "No grocery lists found",
            text: "Build a list by hand, or let a meal plan generate one with the quantities already added up.",
            action_label: "Create a Grocery List",
            action_path: new_grocery_list_path,
            secondary_label: "Go to meal plans",
            secondary_path: meal_plans_path %>
    <% end %>
  <% end %>
</div>
