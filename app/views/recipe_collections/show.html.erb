<div class="rc-show-container">
  <header class="rc-show-header">
    <div class="rc-show-header-content">
      <div>
        <p class="section-eyebrow">Collection</p>
        <h1 class="rc-show-title"><%= @collection.name %></h1>
        <% if @collection.description.present? %>
          <p class="rc-show-description"><%= @collection.description %></p>
        <% end %>
        <div class="rc-show-meta">
          <span class="icon-label">
            <%= icon(:plate, size: 14) %><%= @collection.recipe_count %> <%= 'recipe'.pluralize(@collection.recipe_count) %>
          </span>
          <span class="separator" aria-hidden="true">•</span>
          <span class="icon-label">
            <%= icon(:calendar, size: 14) %>Created <%= time_ago_in_words(@collection.created_at) %> ago
          </span>
        </div>
      </div>

      <div class="rc-show-actions">
        <%= link_to edit_recipe_collection_path(@collection), class: "btn btn-secondary" do %>
          <%= icon(:pencil, size: 16) %>Edit
        <% end %>
        <%= link_to recipe_collection_path(@collection),
              data: { turbo_method: :delete, turbo_confirm: "Delete “#{@collection.name}” and remove all recipes from it?" },
              class: "btn btn-plain btn-plain--danger" do %>
          <%= icon(:trash, size: 16) %>Delete
        <% end %>
      </div>
    </div>
  </header>

  <% if @recipes.any? %>
    <div class="grid grid-3">
      <% @recipes.each do |recipe| %>
        <div class="rc-recipe-slot">
          <%= render "shared/recipe_card", recipe: recipe, quick_edit: false %>
          <%= link_to remove_recipe_recipe_collection_path(@collection, recipe_id: recipe.friendly_id),
                data: { turbo_method: :delete, turbo_confirm: "Remove “#{recipe.title}” from this collection?" },
                class: "rc-remove-btn",
                title: "Remove from collection" do %>
            <%= icon(:close, size: 15, title: "Remove #{recipe.title} from this collection") %>
          <% end %>
        </div>
      <% end %>
    </div>

    <div class="mt-4 text-center pagination-wrap">
      <%= paginate @recipes %>
    </div>
  <% else %>
    <%= render "shared/empty_state",
          icon_name: :books,
          title: "No recipes in this collection yet",
          text: "Open any recipe and use “Add to Collection” to file it in here.",
          action_label: "Browse My Recipes",
          action_path: recipes_path,
          action_icon: :search %>
  <% end %>

  <div class="back-link">
    <%= link_to recipe_collections_path, class: "link-secondary icon-label" do %>
      <%= icon(:arrow_left, size: 15) %>Back to Collections
    <% end %>
  </div>
</div>
